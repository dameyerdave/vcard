ENVOY_IMAGE=envoyproxy/envoy:v1.33-latest
ENVOY_PORT=8081
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
DOCKER_NETWORK_SUBNET=172.28.0.0/24
ENBIZCARD_IP=172.28.0.10
ENVOY_IP=172.28.0.20
CLOUDFLARED_IP=172.28.0.30
PUBLIC_BASE_URL=https://vcard.xuno.ch
CLOUDFLARE_ACCESS_EMAIL_HEADER=cf-access-authenticated-user-email
CARD_DATA_DIR=/app/data
CARD_DATABASE_PATH=/app/data/enbizcard.sqlite
MAX_JSON_BODY_BYTES=104857600
APP_ENV=production
DEV_AUTH_EMAIL=
